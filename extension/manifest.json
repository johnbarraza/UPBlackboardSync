{
  "manifest_version": 3,
  "name": "BlackboardSync Extension",
  "description": "Download Blackboard course resources from the current page.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "blackboardsync@up.edu.pe"
    }
  },
  "action": {
    "default_title": "BlackboardSync",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
